# Texto com quebra de linha normalizada no repositório
* text=auto

# Scripts do Linux precisam de LF; os do Windows, de CRLF
*.sh   text eol=lf
*.bat  text eol=crlf
*.pyw  text eol=lf
*.py   text eol=lf

# Arquivos do pacote .deb e do .dmg são usados no Linux/macOS: sempre LF
packaging/linux/**  text eol=lf
packaging/macos/**  text eol=lf

# Binários
*.png  binary
*.ico  binary
*.msi  binary
*.deb  binary
*.jpg  binary

# Fontes que acompanham o app (OFL.txt e .ttf conferidos por SHA-256 em tests/test_textrender.py): bytes exatos
pelicula/data/fontes/** binary
*.ttf  binary
