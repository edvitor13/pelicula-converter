<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalador .msi do PeliculaConverter (WiX Toolset v5).

  Instalação por usuário (sem administrador) em %LOCALAPPDATA%\Programs\PeliculaConverter.
  Monte com packaging/windows/build_msi.ps1, que passa as variáveis abaixo:

    -d Version=x.y.z        versão do app (só números; o MSI não aceita sufixos)
    -d SourceDir=...        pasta gerada pelo PyInstaller (dist\PeliculaConverter), já com o
                            pelicula-install.json {"kind": "msi"}
    -d RepoDir=...          raiz do repositório (ícone)
    -d LicenseRtf=...       licença MIT em RTF (gerada a partir de LICENSE)

  NUNCA mude o UpgradeCode: é ele que faz um .msi novo substituir o antigo no mesmo lugar
  (o atualizador do app depende disso).

  Propriedades públicas úteis na linha de comando do msiexec:
    ABRIR_APOS_INSTALAR=1   abre o app quando a instalação termina (útil com /passive ou /qn)
    INSTALLFOLDER=C:\...    outra pasta (só na primeira instalação; depois a pasta é lembrada)
    ADDLOCAL / REMOVE       escolher recursos: AtalhoDesktop, AssociacaoPlc, PastaNoPath
-->
<?ifndef Version?>
<?error Defina -d Version=x.y.z?>
<?endif?>
<?ifndef SourceDir?>
<?error Defina -d SourceDir=pasta do PyInstaller?>
<?endif?>
<?ifndef RepoDir?>
<?error Defina -d RepoDir=raiz do repositório?>
<?endif?>
<?ifndef LicenseRtf?>
<?error Defina -d LicenseRtf=arquivo .rtf da licença?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="PeliculaConverter"
           Manufacturer="Vitor Gabriel"
           Version="$(var.Version)"
           UpgradeCode="35055C18-5F06-43BC-85C7-C95E9E42F81B"
           Scope="perUser"
           Language="1046"
           Codepage="1252"
           InstallerVersion="500">

    <SummaryInformation Description="Instalador do PeliculaConverter $(var.Version)"
                        Manufacturer="Vitor Gabriel"
                        Codepage="1252" />

    <!-- Versão nova substitui a antiga no mesmo lugar; a mesma versão pode ser reinstalada. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Uma versão mais nova do [ProductName] já está instalada. Para voltar a esta versão, desinstale a atual antes." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Adicionar ou remover programas: ícone e links -->
    <Icon Id="PeliculaConverter.ico" SourceFile="$(var.RepoDir)\assets\logo.ico" />
    <Property Id="ARPPRODUCTICON" Value="PeliculaConverter.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/edvitor13/pelicula-converter" />
    <Property Id="ARPHELPLINK" Value="https://github.com/edvitor13/pelicula-converter/issues" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/edvitor13/pelicula-converter/releases" />
    <Property Id="ARPCOMMENTS" Value="Simula película cinematográfica em vídeos digitais." />

    <!-- Lembra a pasta escolhida: atualizações instalam no mesmo lugar. -->
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PastaDaInstalacao" Root="HKCU" Key="Software\PeliculaConverter"
                      Name="InstallDir" Type="raw" />
    </Property>
    <Property Id="ABRIR_APOS_INSTALAR" Secure="yes" />

    <!-- Pastas -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramasDoUsuario" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="PeliculaConverter" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- Recursos (o usuário escolhe na tela "Instalação personalizada") -->
    <Feature Id="Principal" Title="PeliculaConverter"
             Description="O aplicativo, o modo de terminal (pelicula-cli) e o atalho no Menu Iniciar."
             Level="1" AllowAbsent="no" AllowAdvertise="no" Display="expand"
             ConfigurableDirectory="INSTALLFOLDER">

      <Component Id="ExecutavelPrincipal" Directory="INSTALLFOLDER" Guid="5E75067B-0B45-48F5-A488-2237E764C503">
        <File Id="PeliculaConverterExe" Source="$(var.SourceDir)\PeliculaConverter.exe" KeyPath="no" />
        <!-- Instalação por usuário: a chave do componente fica no HKCU (e guarda a pasta). -->
        <RegistryValue Root="HKCU" Key="Software\PeliculaConverter" Name="InstallDir" Type="string"
                       Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoverPastaDoApp" On="uninstall" />
      </Component>

      <!-- Todo o resto da pasta do PyInstaller (_internal, pelicula-cli.exe, pelicula-install.json...) -->
      <Files Directory="INSTALLFOLDER" Include="$(var.SourceDir)\**">
        <Exclude Files="$(var.SourceDir)\PeliculaConverter.exe" />
      </Files>

      <Component Id="AtalhoMenuIniciar" Directory="ProgramMenuFolder" Guid="E74A2986-DCBE-4DC2-8195-0A6A214CDCBE">
        <Shortcut Id="AtalhoNoMenu" Name="PeliculaConverter"
                  Description="Simula película cinematográfica em vídeos digitais"
                  Target="[#PeliculaConverterExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\PeliculaConverter" Name="AtalhoMenuIniciar" Type="integer"
                       Value="1" KeyPath="yes" />
      </Component>

      <Feature Id="AtalhoDesktop" Title="Atalho na Área de Trabalho"
               Description="Cria um atalho do PeliculaConverter na Área de Trabalho."
               Level="1" AllowAdvertise="no">
        <Component Id="AtalhoAreaDeTrabalho" Directory="DesktopFolder" Guid="49CC56B6-8CF3-495C-BC92-AB017CBFCF54">
          <Shortcut Id="AtalhoNaAreaDeTrabalho" Name="PeliculaConverter"
                    Description="Simula película cinematográfica em vídeos digitais"
                    Target="[#PeliculaConverterExe]" WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU" Key="Software\PeliculaConverter" Name="AtalhoAreaDeTrabalho" Type="integer"
                         Value="1" KeyPath="yes" />
        </Component>
      </Feature>

      <Feature Id="AssociacaoPlc" Title="Abrir projetos .plc com o PeliculaConverter"
               Description="Associa os arquivos de projeto (.plc) ao PeliculaConverter: dois cliques abrem o projeto."
               Level="1" AllowAdvertise="no">
        <Component Id="AssociacaoPlc" Directory="INSTALLFOLDER" Guid="107B6B3E-215C-4FE6-83AF-363DB7F80927">
          <File Id="IconeDoProjeto" Source="$(var.RepoDir)\assets\logo.ico" Name="pelicula-projeto.ico" KeyPath="no" />
          <RegistryValue Root="HKCU" Key="Software\PeliculaConverter" Name="AssociacaoPlc" Type="integer"
                         Value="1" KeyPath="yes" />
          <!-- Por usuário, o HKCR do MSI vai para HKCU\Software\Classes. -->
          <ProgId Id="PeliculaConverter.Projeto" Description="Projeto do PeliculaConverter"
                  Icon="IconeDoProjeto" IconIndex="0" Advertise="no">
            <Extension Id="plc" ContentType="application/x-pelicula-project">
              <Verb Id="open" Command="Abrir" TargetFile="PeliculaConverterExe" Argument="&quot;%1&quot;" />
            </Extension>
          </ProgId>
        </Component>
      </Feature>

      <Feature Id="PastaNoPath" Title="Usar o pelicula-cli no terminal"
               Description="Acrescenta a pasta do PeliculaConverter ao PATH do usuário (vale para terminais abertos depois da instalação)."
               Level="1" AllowAdvertise="no">
        <Component Id="PastaNoPath" Directory="INSTALLFOLDER" Guid="DD314F45-4DF1-4CB9-A83B-1BB109B54778">
          <Environment Id="PathDoUsuario" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set"
                       System="no" Permanent="no" />
          <RegistryValue Root="HKCU" Key="Software\PeliculaConverter" Name="PastaNoPath" Type="integer"
                         Value="1" KeyPath="yes" />
        </Component>
      </Feature>
    </Feature>

    <!-- Interface: boas-vindas, licença MIT, escolha de recursos e pasta, progresso, fim. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Abrir o PeliculaConverter agora" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#PeliculaConverterExe]" />
    <CustomAction Id="AbrirPeliculaConverter" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
                  Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_FeatureTree" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="AbrirPeliculaConverter"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Sem interface (/passive, /qn): ABRIR_APOS_INSTALAR=1 abre o app no fim. -->
    <InstallExecuteSequence>
      <Custom Action="AbrirPeliculaConverter" After="InstallFinalize"
              Condition="ABRIR_APOS_INSTALAR = 1 AND NOT (REMOVE ~= &quot;ALL&quot;)" />
    </InstallExecuteSequence>
  </Package>
</Wix>
